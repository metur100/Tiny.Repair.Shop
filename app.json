{
  "expo": {
    "name": "Tiny Repair Shop",
    "slug": "tiny-repair-shop",
    "scheme": "tinyrepairshop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF6E6",
    "primaryColor": "#F28C38",
    "description": "A cozy repair workshop game: fix, clean, paint and test treasured objects for friendly customers.",
    "githubUrl": "https://github.com/metur100/Tiny.Repair.Shop",
    "ios": {
      "bundleIdentifier": "com.certidevelopment.tinyrepairshop",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.certidevelopment.tinyrepairshop",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFE7C2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E6"
        }
      ],
      "expo-font"
    ]
  }
}
